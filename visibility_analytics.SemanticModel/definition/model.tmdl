model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: cs-CZ
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Monthly","Weekly","Dim Category","Dim Metric","Dim Date","_Measures"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table Monthly
ref table Weekly
ref table 'Dim Category'
ref table 'Dim Metric'
ref table 'Dim Date'
ref table _Measures

ref cultureInfo en-US

